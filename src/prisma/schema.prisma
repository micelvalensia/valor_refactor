// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// 1. User & Gamification Models
// -------------------------------------------------------------

model User {
  id                 String       @id @default(cuid())
  username           String       @unique
  email              String       @unique
  email_verified_at  DateTime?
  description        String?
  password           String
  exp                Int          @default(0)

  level_id           String?
  level              Level?       @relation(fields: [level_id], references: [id])

  created_at         DateTime     @default(now())
  updated_at         DateTime     @default(now()) @updatedAt

  // Relations
  exp_logs                 UserExpLog[]
  posts                    Post[]
  ratings                  PostRating[]
  comments                 PostComment[]
  comment_reactions        CommentReaction[]
  notifications_received   NotificationLog[] @relation("NotificationRecipient")
  notifications_triggered  NotificationLog[] @relation("NotificationActor")

  @@map("users")
}

model Level {
  id             String            @id @default(cuid())
  level_number   Int               @unique
  exp_required   Int
  title          String

  users          User[]

  @@map("levels")
}

model LevelMilestone {
  id             String            @id @default(cuid())
  min_level      Int
  title          String
  reward_desc    String

  @@map("level_milestones")
}

model UserExpLog {
  id             String            @id @default(cuid())
  user_id        String
  exp_amount     Int
  source         String
  created_at     DateTime          @default(now())

  user           User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_exp_logs")
}

// -------------------------------------------------------------
// 2. Post & Subtypes (Parent-Child Pattern)
// -------------------------------------------------------------

model Post {
  id             String            @id @default(cuid())
  created_by     String
  type           String            // "project" | "problem"
  created_at     DateTime          @default(now())

  // Relations
  user           User              @relation(fields: [created_by], references: [id], onDelete: Cascade)
  project        PostProject?
  problem        PostProblem?
  images         PostImage[]
  stacks         PostStack[]
  ratings        PostRating[]
  comments       PostComment[]

  @@map("posts")
}

model PostProject {
  id              String           @id @default(cuid())
  post_id         String           @unique
  title           String
  description     String           @db.Text
  demo_url        String?
  repository_url  String?

  post            Post             @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@map("post_project")
}

model PostProblem {
  id             String            @id @default(cuid())
  post_id        String            @unique
  title          String
  description    String            @db.Text

  post           Post              @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@map("post_problem")
}

// -------------------------------------------------------------
// 3. Stacks & Images
// -------------------------------------------------------------

model Stack {
  id             String            @id @default(cuid())
  title          String            @unique

  post_stacks    PostStack[]

  @@map("stacks")
}

model PostStack {
  id             String            @id @default(cuid())
  post_id        String
  stack_id       String

  post           Post              @relation(fields: [post_id], references: [id], onDelete: Cascade)
  stack          Stack             @relation(fields: [stack_id], references: [id], onDelete: Cascade)

  @@unique([post_id, stack_id])
  @@map("post_stack")
}

model PostImage {
  id             String            @id @default(cuid())
  post_id        String
  image_size     String
  image_url      String

  post           Post              @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@map("post_images")
}

// -------------------------------------------------------------
// 4. Interactions & Notifications
// -------------------------------------------------------------

model PostRating {
  id             String            @id @default(cuid())
  post_id        String
  user_id        String
  score          Int
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  post           Post              @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
  @@map("post_ratings")
}

model PostComment {
  id             String            @id @default(cuid())
  post_id        String
  user_id        String
  content        String            @db.Text
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  post           Post              @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reactions      CommentReaction[]

  @@map("post_comments")
}

model CommentReaction {
  id             String            @id @default(cuid())
  comment_id     String
  user_id        String
  type           String
  created_at     DateTime          @default(now())

  comment        PostComment       @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([comment_id, user_id])
  @@map("comment_reactions")
}

model NotificationLog {
  id             String            @id @default(cuid())
  user_id        String            // penerima notifikasi
  actor_id       String            // pelaku aksi
  type           String            // comment, rating, dll
  reference_id   String            // post_id atau comment_id
  message        String
  is_read        Boolean           @default(false)
  created_at     DateTime          @default(now())

  user           User              @relation("NotificationRecipient", fields: [user_id], references: [id], onDelete: Cascade)
  actor          User              @relation("NotificationActor", fields: [actor_id], references: [id], onDelete: Cascade)

  @@map("notification_logs")
}